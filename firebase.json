{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "node-v20.18.0-win-x64/**",
      "tools/**",
      "*.bat",
      "*.sh",
      "*.cmd",
      "*.exe",
      "*.bak",
      "*.zip",
      "*.log",
      "*.txt",
      "firepit-log.txt",
      "server.js",
      "nginx.conf",
      "web.config",
      "start-local.*",
      "backend/**",
      "oracle-vision-agent/**",
      "oracle_backup/**",
      "**/*.py",
      "**/*.pyc",
      "**/*.sh",
      "**/*.bat",
      "**/*.cmd",
      "**/*.exe",
      "**/*.db",
      "**/*.sqlite*",
      "specs/**",
      ".specify/**",
      "ARCHITECTURE.md",
      "CHANGELOG.md",
      "skills-lock.json",
      "test-*.js"
    ],
    "cleanUrls": false,
    "rewrites": [
      {
        "source": "/field",
        "destination": "/field.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/quality",
        "destination": "/quality.html"
      },
      {
        "source": "/dashboard",
        "destination": "/dashboard.html"
      },
      {
        "source": "/head",
        "destination": "/head.html"
      },
      {
        "source": "/profile",
        "destination": "/profile.html"
      },
      {
        "source": "/executive_report",
        "destination": "/executive_report.html"
      }
    ],
    "headers": [
      {
        "source": "sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "manifest.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/manifest+json; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "assets/js/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=604800"
          }
        ]
      },
      {
        "source": "**/*.@(html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
