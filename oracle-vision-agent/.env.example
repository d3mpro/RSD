# ==============================================================================
# إعدادات وكيل الرؤية البصرية الذكي - المدينة الطبية بجامعة الملك سعود (KSUMC)
# Oracle Cloud AI Vision Agent Configuration (GPT-4o + Qwen2.5-VL + Ollama + Gemini)
# ==============================================================================

# 1. مفتاح أمان المنصة (يجب أن يطابق X-KSUMC-KEY في ksu-ai-client.js)
KSUMC_SECURITY_TOKEN=ksu_sec_token_95972_riyadh

# 2. ترتيب أولوية المحركات الاحتياطية على الخادم (افصل بينها بفاصلة):
# الخيارات المتاحة: github_models, qwen_api, ollama_local, gemini_api
AI_PROVIDER_PRIORITY=github_models,qwen_api,ollama_local,gemini_api

# ------------------------------------------------------------------------------
# أ) إعدادات نماذج Microsoft GitHub Models (GPT-4o Vision - محرك Copilot)
# استخرج رمز Fine-grained PAT بصلاحية Models: Read-only من GitHub (لا تضعه في الكود العام)
# ------------------------------------------------------------------------------
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference/chat/completions
GITHUB_MODELS_KEYS=
GITHUB_VISION_MODEL=openai/gpt-4o
GITHUB_FALLBACK_VISION_MODEL=openai/gpt-4o-mini
GITHUB_TEXT_MODEL=openai/gpt-4o-mini

# ------------------------------------------------------------------------------
# ب) إعدادات نموذج كوين البصري السحابي (Qwen2.5-VL API - متوافق مع OpenAI)
# يعمل مع: OpenRouter (مجاني/مدفوع)، Alibaba DashScope، Together AI، SiliconFlow
# ------------------------------------------------------------------------------
QWEN_API_BASE_URL=https://openrouter.ai/api/v1/chat/completions
QWEN_API_KEYS=
QWEN_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct:free
QWEN_TEXT_MODEL=qwen/qwen-2.5-72b-instruct:free

# ------------------------------------------------------------------------------
# ج) إعدادات نموذج كوين المحلي على خادم أوراكل (Local Ollama - مجاني 100% بلا حدود)
# ------------------------------------------------------------------------------
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_TEXT_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=90

# ------------------------------------------------------------------------------
# د) إعدادات مفاتيح Google Gemini الاحتياطية (تدوير تلقائي عند نفاد الحصة)
# ------------------------------------------------------------------------------
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# هـ) إعدادات الأرشفة الآلية الاختيارية إلى البريد الجامعي (Power Automate -> OneDrive/SharePoint)
# عند تفعيلها يرسل الخادم مرفقات [RSD-ARCHIVE] تلقائياً إلى البريد الجامعي
# ------------------------------------------------------------------------------
ARCHIVE_VAULT_DIR=archive_vault
ARCHIVE_SMTP_HOST=
ARCHIVE_SMTP_PORT=587
ARCHIVE_SMTP_USER=
ARCHIVE_SMTP_PASS=
ARCHIVE_TARGET_EMAIL=aalsaqri@ksu.edu.sa

# ------------------------------------------------------------------------------
# و) إعدادات الأداء والضغط والتخزين المؤقت (Caching & Compression)
# ------------------------------------------------------------------------------
MAX_IMAGE_DIMENSION=1024
JPEG_QUALITY=78
CACHE_TTL_SECONDS=1800
PORT=8000
