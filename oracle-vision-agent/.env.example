# ==============================================================================
# إعدادات وكيل الرؤية البصرية الذكي - المدينة الطبية بجامعة الملك سعود (KSUMC)
# Oracle Cloud AI Vision Agent Configuration (Qwen2.5-VL + Ollama + Gemini)
# ==============================================================================

# 1. مفتاح أمان المنصة (يجب أن يطابق X-KSUMC-KEY في ksu-ai-client.js)
KSUMC_SECURITY_TOKEN=ksu_sec_token_95972_riyadh

# 2. ترتيب أولوية المحركات (افصل بينها بفاصلة):
# الخيارات المتاحة: qwen_api, ollama_local, gemini_api
AI_PROVIDER_PRIORITY=qwen_api,ollama_local,gemini_api

# ------------------------------------------------------------------------------
# أ) إعدادات نموذج كوين البصري السحابي (Qwen2.5-VL API - متوافق مع OpenAI)
# يعمل مع: OpenRouter (مجاني/مدفوع)، Alibaba DashScope، Together AI، SiliconFlow
# ------------------------------------------------------------------------------
# مثال OpenRouter: https://openrouter.ai/api/v1/chat/completions
# مثال Alibaba DashScope (العالمي): https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_API_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# يمكنك وضع مفتاح واحد أو عدة مفاتيح مفصولة بفاصلة للتدوير التلقائي (Key Rotation)
QWEN_API_KEYS=

# اسم نموذج كوين البصري المطلوب:
# في OpenRouter المجاني: qwen/qwen2.5-vl-72b-instruct:free أو qwen/qwen2.5-vl-32b-instruct:free
# في DashScope الرسمي: qwen2.5-vl-72b-instruct أو qwen-vl-max
QWEN_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct:free
QWEN_TEXT_MODEL=qwen/qwen-2.5-72b-instruct:free

# ------------------------------------------------------------------------------
# ب) إعدادات نموذج كوين المحلي على خادم أوراكل (Local Ollama - مجاني 100% بلا حدود)
# ------------------------------------------------------------------------------
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
# لخادم أوراكل المجاني (Ampere 4 OCPU / 24GB RAM) ننصح بـ qwen2.5vl:3b للسرعة أو qwen2.5vl:7b للدقة
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_TEXT_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=90

# ------------------------------------------------------------------------------
# ج) إعدادات مفاتيح Google Gemini الاحتياطية (تدوير تلقائي عند نفاد الحصة)
# ضع عدة مفاتيح مفصولة بفاصلة: AIzaSy...,AIzaSy...
# ------------------------------------------------------------------------------
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# د) إعدادات الأداء والضغط والتخزين المؤقت (Caching & Compression)
# ------------------------------------------------------------------------------
MAX_IMAGE_DIMENSION=1024
JPEG_QUALITY=78
CACHE_TTL_SECONDS=1800
PORT=8000
