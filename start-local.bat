@echo off
chcp 65001 >nul
title تشغيل نظام السلامة والصحة المهنية - جامعة الملك سعود
echo =====================================================================
echo    الإدارة العامة للسلامة والصحة المهنية - المدينة الطبية بجامعة الملك سعود
echo    منصة رصد الذكية - نظام جولات السلامة الميدانية بالمدينة الطبية بجامعة الملك سعود
echo =====================================================================
echo.
echo [1] جاري التحقق من بيئة التشغيل...
where node >nul 2>nul
if %ERRORLEVEL% equ 0 (
    echo [OK] تم العثور على Node.js. جاري تشغيل الخادم المحلي...
    echo.
    echo * بوابة النظام الرئيسية:   http://localhost:8080/
    echo * صفحة ملف شارك 7:         http://localhost:8080/sharek
    echo.
    start http://localhost:8080
    node server.js
) else (
    echo [!] Node.js غير مثبت. سيتم فتح النظام مباشرة في المتصفح الافتراضي...
    start index.html
)
pause
