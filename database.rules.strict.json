{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null",
      ".indexOn": ["username", "empId", "roleCategory", "shift", "status", "authUid"],
      "$userId": {
        ".write": "auth != null && newData.exists() && (auth.uid == $userId || auth.token.role == 'admin' || auth.token.role == 'developer')",
        ".validate": "(newData.hasChildren(['id', 'name']) || newData.hasChildren(['username'])) && !newData.hasChildren(['password']) && !newData.hasChildren(['passwordHash']) && (!newData.hasChild('id') || (newData.child('id').isString() && newData.child('id').val().length < 100))"
      }
    },

    "ksumc_users": {
      ".read": "auth != null",
      "$userId": {
        ".write": "auth != null && newData.exists() && (auth.uid == $userId || auth.token.role == 'admin' || auth.token.role == 'developer')",
        ".validate": "newData.hasChildren(['id']) && !newData.hasChildren(['password']) && !newData.hasChildren(['passwordHash']) && newData.child('id').isString() && newData.child('id').val().length < 100"
      }
    },

    "rounds": {
      ".read": "auth != null",
      ".indexOn": ["timestamp", "inspectorName", "facility", "building", "checklistType", "status", "createdByUid"],
      "$roundId": {
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.hasChildren(['id', 'timestamp']) && newData.child('id').isString() && newData.child('id').val().length < 100"
      }
    },

    "shift_inspection_logs": {
      ".read": "auth != null",
      ".indexOn": ["timestamp", "date", "shift", "supervisor"],
      "$logId": {
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.hasChildren(['id', 'timestamp', 'date', 'shift']) && newData.child('id').isString() && newData.child('id').val().length < 100"
      }
    },

    "safety_dept_reports": {
      ".read": "auth != null",
      ".indexOn": ["timestamp", "date", "facility", "shift"],
      "$reportId": {
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.hasChildren(['id', 'timestamp', 'date', 'shift']) && newData.child('id').isString() && newData.child('id').val().length < 100"
      }
    },

    "compliance_registry": {
      ".read": "auth != null",
      ".indexOn": ["standard", "status", "category"],
      "$recordId": {
        ".write": "auth != null && newData.exists() && (auth.token.role == 'head' || auth.token.role == 'admin' || auth.token.role == 'developer' || auth.token.role == 'quality')",
        ".validate": "newData.hasChildren(['id', 'standard', 'status']) && newData.child('id').isString() && newData.child('id').val().length < 100"
      }
    },

    "doors": {
      ".read": "auth != null",
      ".indexOn": ["timestamp", "doorId", "status", "building"],
      "$doorId": {
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.hasChildren(['id']) && newData.child('id').isString() && newData.child('id').val().length < 100"
      }
    },

    "permits": {
      ".read": "auth != null",
      ".indexOn": ["timestamp", "permitType", "status", "building"],
      "$permitId": {
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.hasChildren(['id']) && newData.child('id').isString() && newData.child('id').val().length < 100"
      }
    },

    "alarms": {
      ".read": "auth != null",
      ".indexOn": ["timestamp", "alarmCode", "status", "building"],
      "$alarmId": {
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.hasChildren(['id']) && newData.child('id').isString() && newData.child('id').val().length < 100"
      }
    },

    "shift_incidents": {
      ".read": "auth != null",
      ".indexOn": ["timestamp", "severity", "status", "location"],
      "$incidentId": {
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.hasChildren(['id', 'timestamp', 'severity']) && newData.child('id').isString() && newData.child('id').val().length < 100"
      }
    },

    "incidents": {
      ".read": "auth != null",
      ".indexOn": ["timestamp", "severity", "status"],
      "$incidentId": {
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.hasChildren(['id', 'timestamp']) && newData.child('id').isString() && newData.child('id').val().length < 100"
      }
    },

    "safety_violations": {
      ".read": "auth != null && ((auth.token.role == 'head' || auth.token.role == 'admin' || auth.token.role == 'developer' || auth.token.role == 'executive' || auth.token.role == 'quality') || (query.orderByChild == 'createdByUid' && query.equalTo == auth.uid))",
      ".indexOn": ["timestamp", "severity", "status", "building", "createdByUid", "createdByEmpId", "archived", "shift"],
      "$violId": {
        ".read": "auth != null && ((auth.token.role == 'head' || auth.token.role == 'admin' || auth.token.role == 'developer' || auth.token.role == 'executive' || auth.token.role == 'quality') || (data.exists() && data.child('createdByUid').val() == auth.uid && data.child('archived').val() != true))",
        ".write": "auth != null && newData.exists() && ((auth.token.role == 'head' || auth.token.role == 'admin' || auth.token.role == 'developer' || auth.token.role == 'executive') || (!data.exists() && newData.child('createdByUid').val() == auth.uid && newData.child('archived').val() != true && newData.child('isArchived').val() != true) || (data.exists() && data.child('createdByUid').val() == auth.uid && data.child('archived').val() != true && newData.child('archived').val() != true && newData.child('isArchived').val() != true && newData.child('createdByUid').val() == data.child('createdByUid').val()))",
        ".validate": "newData.hasChildren(['id', 'timestamp']) && newData.child('id').isString() && newData.child('id').val().length < 100 && (!newData.child('status').exists() || newData.child('status').val() != 'deleted')"
      }
    },

    "smoking_violations": {
      ".read": "auth != null && ((auth.token.role == 'head' || auth.token.role == 'admin' || auth.token.role == 'developer' || auth.token.role == 'executive' || auth.token.role == 'quality') || (query.orderByChild == 'createdByUid' && query.equalTo == auth.uid))",
      ".indexOn": ["timestamp", "status", "building", "createdByUid", "createdByEmpId", "archived", "shift"],
      "$violId": {
        ".read": "auth != null && ((auth.token.role == 'head' || auth.token.role == 'admin' || auth.token.role == 'developer' || auth.token.role == 'executive' || auth.token.role == 'quality') || (data.exists() && data.child('createdByUid').val() == auth.uid && data.child('archived').val() != true))",
        ".write": "auth != null && newData.exists() && ((auth.token.role == 'head' || auth.token.role == 'admin' || auth.token.role == 'developer' || auth.token.role == 'executive') || (!data.exists() && newData.child('createdByUid').val() == auth.uid && newData.child('archived').val() != true && newData.child('isArchived').val() != true) || (data.exists() && data.child('createdByUid').val() == auth.uid && data.child('archived').val() != true && newData.child('archived').val() != true && newData.child('isArchived').val() != true && newData.child('createdByUid').val() == data.child('createdByUid').val()))",
        ".validate": "newData.hasChildren(['id', 'timestamp']) && newData.child('id').isString() && newData.child('id').val().length < 100 && (!newData.child('status').exists() || newData.child('status').val() != 'deleted')"
      }
    },

    "audit_logs": {
      ".read": "auth != null && (auth.token.role == 'head' || auth.token.role == 'admin' || auth.token.role == 'developer' || auth.token.role == 'executive')",
      ".indexOn": ["timestamp", "action", "actorEmpId", "actorRole"],
      "$logId": {
        ".write": "auth != null && newData.exists() && !data.exists()",
        ".validate": "newData.hasChildren(['id', 'action', 'timestamp']) && newData.child('id').isString() && newData.child('id').val().length < 100"
      }
    },

    "department_targets": {
      ".read": "auth != null",
      ".write": "auth != null && newData.exists() && (auth.token.role == 'head' || auth.token.role == 'admin' || auth.token.role == 'developer')"
    },

    "capa_records": {
      ".read": "auth != null",
      ".indexOn": ["timestamp", "dueDate", "status", "severity", "building"],
      "$capaId": {
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.hasChildren(['id', 'timestamp']) && newData.child('id').isString() && newData.child('id').val().length < 100"
      }
    },

    "notifications": {
      ".read": "auth != null",
      ".indexOn": ["timestamp", "priority", "targetRole"],
      "$notifId": {
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.hasChildren(['id']) && (newData.hasChild('timestamp') || newData.hasChild('createdAt') || newData.hasChild('date'))"
      }
    },

    "ai_queue": {
      ".read": "auth != null",
      ".indexOn": ["status", "createdAt", "action"],
      "$taskId": {
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.hasChildren(['status', 'createdAt'])"
      }
    },

    "system_status": {
      ".read": "auth != null",
      ".write": false,
      "lastUpdate": {
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.hasChildren(['timestamp'])"
      },
      "shiftLogResetAt": {
        ".write": "auth != null && newData.exists() && (auth.token.role == 'head' || auth.token.role == 'admin' || auth.token.role == 'developer' || auth.token.role == 'quality')",
        ".validate": "newData.hasChildren(['timestamp'])"
      },
      "prodCleanVersion": {
        ".write": "auth != null && newData.exists() && (auth.token.role == 'admin' || auth.token.role == 'developer')",
        ".validate": "newData.isString() && newData.val().length < 100"
      },
      "systemMode": {
        ".write": "auth != null && newData.exists() && (auth.token.role == 'admin' || auth.token.role == 'developer')",
        ".validate": "newData.isString() && newData.val().length < 50"
      }
    },

    "system_config": {
      ".read": "auth != null && (auth.token.role == 'head' || auth.token.role == 'admin' || auth.token.role == 'developer')",
      ".write": "auth != null && newData.exists() && (auth.token.role == 'admin' || auth.token.role == 'developer')"
    }
  }
}
